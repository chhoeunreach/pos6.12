APP_NAME="Ultimate POS"
APP_TITLE="Ultimate POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_LOCALE=en
APP_TIMEZONE="Asia/Phnom_Penh"

LOG_CHANNEL=daily
LOG_LEVEL=debug

ADMINISTRATOR_USERNAMES=
ALLOW_REGISTRATION=true
ENABLE_GST_REPORT_INDIA=false
SHOW_REPAIR_STATUS_LOGIN_SCREEN=true
POS_RECENT_TRANSACTIONS_DISPLAY_LIMIT=10

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ultimate_pos
DB_USERNAME=root
DB_PASSWORD=secret
DB_SOCKET=

ACCESSORY_DB_CONNECTION=accessory
ACCESSORY_DB_HOST=mysql
ACCESSORY_DB_PORT=3306
ACCESSORY_DB_DATABASE=ky_accessory
ACCESSORY_DB_USERNAME=root
ACCESSORY_DB_PASSWORD=secret
ACCESSORY_DB_SOCKET=
ACCESSORY_MYSQL_ATTR_SSL_CA=

SERVICE_DB_CONNECTION=service
SERVICE_DB_HOST=mysql
SERVICE_DB_PORT=3306
SERVICE_DB_DATABASE=ky_services
SERVICE_DB_USERNAME=root
SERVICE_DB_PASSWORD=secret
SERVICE_DB_SOCKET=
SERVICE_MYSQL_ATTR_SSL_CA=

DB_LOAN_HOST=mysql
DB_LOAN_PORT=3306
DB_LOAN_DATABASE=loan_management
DB_LOAN_USERNAME=root
DB_LOAN_PASSWORD=secret
DB_LOAN_SOCKET=

HR_DB_HOST=mysql
HR_DB_PORT=3306
HR_DB_DATABASE=hr
HR_DB_USERNAME=root
HR_DB_PASSWORD=secret
HR_DB_SOCKET=
HR_MYSQL_ATTR_SSL_CA=

BROADCAST_DRIVER=null
CACHE_DRIVER=redis
SESSION_DRIVER=file
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

IMPORT_QUEUE=imports
IMPORT_DISK=local
IMPORT_CHUNK_SIZE=500
IMPORT_MAX_UPLOAD_KB=102400
IMPORT_CLEANUP_AFTER_DAYS=14

EXPORT_QUEUE=exports
EXPORT_DISK=local
EXPORT_CHUNK_SIZE=2000
EXPORT_DOWNLOAD_TTL_HOURS=72
EXPORT_CLEANUP_AFTER_DAYS=14

WKHTMLTOPDF_ENABLED=true
WKHTMLTOPDF_BINARY=/usr/bin/wkhtmltopdf
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_PDF_ENGINE=wkhtmltopdf
NOTIFICATION_CLEANUP_DAYS=7
NOTIFICATION_RETRY_ATTEMPTS=3
TELEGRAM_BOT_TOKEN=

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

ENVATO_PURCHASE_CODE=
MAC_LICENCE_CODE=

BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=
DROPBOX_ACCESS_TOKEN=

STRIPE_PUB_KEY=
STRIPE_SECRET_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_APP_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_API_USERNAME=
PAYPAL_SANDBOX_API_PASSWORD=
PAYPAL_SANDBOX_API_SECRET=
PAYPAL_LIVE_API_USERNAME=
PAYPAL_LIVE_API_PASSWORD=
PAYPAL_LIVE_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CURRENCY=KES
PESAPAL_LIVE=false

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
