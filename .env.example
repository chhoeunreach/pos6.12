MY_FATOORAH_API_KEY=
MY_FATOORAH_IS_TEST=true
MY_FATOORAH_COUNTRY_ISO=

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
